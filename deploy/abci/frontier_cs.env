# Credential-free deployment settings. A release env file must set the image
# manifest, materialized catalog, adapter revision, and dedicated host Python.
export FRONTIER_SOURCE_ROOT=${FRONTIER_SOURCE_ROOT:-/home/aci18912it/source/Frontier-CS}
export FRONTIER_ADAPTER_REVISION=${FRONTIER_ADAPTER_REVISION:?Set the committed adapter revision}
export FRONTIER_MATERIALIZED_ROOT=${FRONTIER_MATERIALIZED_ROOT:?Set the pinned materialized catalog}
export FRONTIER_IMAGE_MANIFEST=${FRONTIER_IMAGE_MANIFEST:?Set the ready image manifest}
export FRONTIER_PYTHON=${FRONTIER_PYTHON:?Set the dedicated adapter Python}
export FRONTIER_SANDBOX_BACKEND_ROOT=${FRONTIER_SANDBOX_BACKEND_ROOT:-/home/aci18912it/source/swe-runtime-frontier-v23}
export FRONTIER_SANDBOX_REVISION=ac655366358b891419ba7287f82e69efb21434e2
export FRONTIER_JUDGE_CONCURRENCY=${FRONTIER_JUDGE_CONCURRENCY:-4}
export FRONTIER_SESSION_ROOT=${PBS_LOCALDIR:?}/frontier-cs/sessions
export SWE_APPTAINER_SESSION_ROOT=$FRONTIER_SESSION_ROOT
export SWE_SINGULARITY_SESSION_ROOT=$FRONTIER_SESSION_ROOT
export SWE_APPTAINER_IMAGE_CACHE=${PBS_LOCALDIR:?}/frontier-cs/image-cache
export SWE_SINGULARITY_IMAGE_CACHE=$SWE_APPTAINER_IMAGE_CACHE
export SINGULARITY_CACHEDIR=${PBS_LOCALDIR:?}/frontier-cs/singularity-cache
export SINGULARITY_TMPDIR=${PBS_LOCALDIR:?}/frontier-cs/singularity-tmp
export SWE_APPTAINER_OVERLAY_SIZE_MB=8192
export SWE_APPTAINER_OVERLAY_SPARSE=1
export SWE_SINGULARITY_WRITABLE_DIRECTORY=1
export SWE_SINGULARITY_MEMORY_LIMIT_BYTES=68719476736
export SWE_HOST_PROCESS_OUTPUT_MAX_BYTES=16777216
export OPENREWARD_FRONTIER_CS_PORT=8085
