# deploy/abci/toolathlon.env - the Toolathlon service helper's environment (design contract C12). Non-secret and
# self-contained: deploy/abci/toolathlon_service.sh sources THIS file instead of /home/aci18912it/rasp/config/abci.env, which
# chains secrets.env. The SIF identity block is copied verbatim from
# /home/aci18912it/rasp/releases/platoon-v8r33-07bebf9-057108f/pbs-scripts/openreward-v9-abci.env (lines 71-80);
# the helper verifies the SIF's sha256 and its base/OCI/portability labels before staging it to node-local storage.
# Inputs: PLATOON_ROOT (worktree holding plugins/openreward/scripts), PBS_LOCALDIR (node-local scratch).
export PLATOON_CONTAINER_RUNTIME=/usr/bin/singularity
export OPENREWARD_TOOLATHLON_SIF=/groups/gai51740/aci18912it/rasp/images/openreward-toolathlon-18e62c0d-pbs-53541066e97b.sif
export OPENREWARD_TOOLATHLON_SIF_SHA256=11d158f7c1a76486f1338f8cf90ce8a0280962792c0e5c95559f19cc391cda14
export OPENREWARD_TOOLATHLON_SOURCE_REVISION=18e62c0d0419da88209af911528f2f8a0b44a5ed
export OPENREWARD_TOOLATHLON_SOURCE_URL=https://github.com/ApGa/toolathlon-gym
export OPENREWARD_TOOLATHLON_OCI_AMD64_DIGEST=sha256:c1e60b3673c848b758bda1b32ec39898feb5d6ff4c7e55ead8661adb04b327bd
export OPENREWARD_TOOLATHLON_BASE_SIF_SHA256=e730e11d1abc63f5cac9eb1788e36da79aa9c7027ed89d91ee42a5b1e311e267
export OPENREWARD_TOOLATHLON_PORTABILITY_PATCH_SHA256=53541066e97beed06c4e0997969bf745a686e0542654dab763532a539317ba2b
export OPENREWARD_TOOLATHLON_PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
# entrypoint + PGDATA stager (byte-identical to the release's plugins/openreward/scripts today)
export TOOLATHLON_SCRIPTS_ROOT=${PLATOON_ROOT:-/home/aci18912it/source/platoon-tinker}/plugins/openreward/scripts
# singularity scratch on the node-local NVMe (never $HOME)
export SINGULARITY_CACHEDIR=${PBS_LOCALDIR:?PBS_LOCALDIR is required}/toolathlon/singularity-cache
export SINGULARITY_TMPDIR=${PBS_LOCALDIR}/toolathlon/singularity-tmp
export APPTAINER_CACHEDIR=${SINGULARITY_CACHEDIR}
export APPTAINER_TMPDIR=${SINGULARITY_TMPDIR}
# node memory guard contract: openreward-node-memory-guard.py validate_exact_contract accepts exactly this 5-tuple
# (1920 GiB PBS chunk, fail closed at 85 %, MemAvailable fallback 256 GiB, 2 s poll, 60 s telemetry)
export OPENREWARD_NODE_MEMORY_LIMIT_BYTES=2061584302080
export OPENREWARD_NODE_MEMORY_TRIGGER_PERCENT=85
export OPENREWARD_NODE_MEMORY_FALLBACK_AVAILABLE_BYTES=274877906944
export OPENREWARD_NODE_MEMORY_POLL_SECONDS=2
export OPENREWARD_NODE_MEMORY_TELEMETRY_SECONDS=60
