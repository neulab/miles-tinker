# deploy/abci/toolathlon.env - the Toolathlon service helper's environment (design contract C12). Non-secret and
# self-contained: deploy/abci/toolathlon_service.sh sources THIS file instead of /home/aci18912it/rasp/config/abci.env, which
# chains secrets.env. The SIF identity block is the one its build wrote,
# /groups/gai51740/aci18912it/platoon-next/toolathlon-audit/ghcr-c66ff0d/abci-sif/toolathlon-c66ff0d.env:
# ghcr.io/apga/toolathlon-gym:c66ff0d (ApGa/toolathlon-gym c66ff0d) with the PBS portability patch, the build recipe in
# rasp's containers/. Its graders keep cd86c47's fixes: no task pays a do-nothing episode (76 did on 18e62c0d),
# partial mode no longer reads an eval_result.json the agent wrote, and graders run from the image's /app/tasks, which
# root owns. Here that keeps an agent from rewriting them, because Singularity runs the service and the agent's tools
# as a non-root user; under Docker (root in the container) or enroot (a user-owned root filesystem) it doesn't. New in
# c66ff0d: 41 graders fail closed on deliverables they can't read, and the image's own tool catalog lists the
# snowflake tools. Still open in every SIF so far: the helper binds the entrypoint at
# /app/openreward-toolathlon-resilient-entrypoint.sh, which no SIF has, and that makes /app itself (not /app/tasks)
# writable by the same user, who can then replace /app/server.py and /app/task_process.py. OCI_AMD64_DIGEST and
# BASE_SIF_SHA256 name this image and the SIF pulled from it. The helper verifies the SIF's sha256 and its
# base/OCI/portability labels before staging it to node-local storage.
# Inputs: PLATOON_ROOT (worktree holding plugins/openreward/scripts), PBS_LOCALDIR (node-local scratch).
export PLATOON_CONTAINER_RUNTIME=/usr/bin/singularity
export OPENREWARD_TOOLATHLON_SIF=/groups/gai51740/aci18912it/platoon-next/toolathlon-audit/ghcr-c66ff0d/abci-sif/openreward-toolathlon-c66ff0d-pbs-7034e1a61a4a.sif
export OPENREWARD_TOOLATHLON_SIF_SHA256=2fb0ee8ba5377a79206af36c4645c6e32242300aad5cf08677addc8e25ba468d
export OPENREWARD_TOOLATHLON_SOURCE_REVISION=c66ff0d6a827c803e4a0db09c24367d50b9bd06b
export OPENREWARD_TOOLATHLON_SOURCE_URL=https://github.com/ApGa/toolathlon-gym
export OPENREWARD_TOOLATHLON_OCI_AMD64_DIGEST=sha256:b0e8ed72c025018e930b9dc0a9585f5df7cbfd502b95eb01a52c15554851ca30
export OPENREWARD_TOOLATHLON_BASE_SIF_SHA256=7034db8adaa6a396ec61b579a51e0e706f45ddb9c38f19c8085bec7b1cc6b97b
export OPENREWARD_TOOLATHLON_PORTABILITY_PATCH_SHA256=7034e1a61a4a3b9b914fa15281720123d67c13de8f960617f60beaf99c5d7a9d
export OPENREWARD_TOOLATHLON_PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
# entrypoint + PGDATA stager (byte-identical to the release's plugins/openreward/scripts today)
export TOOLATHLON_SCRIPTS_ROOT=${PLATOON_ROOT:-/home/aci18912it/source/platoon-tinker}/plugins/openreward/scripts
# singularity scratch on the node-local NVMe (never $HOME)
export SINGULARITY_CACHEDIR=${PBS_LOCALDIR:?PBS_LOCALDIR is required}/toolathlon/singularity-cache
export SINGULARITY_TMPDIR=${PBS_LOCALDIR}/toolathlon/singularity-tmp
export APPTAINER_CACHEDIR=${SINGULARITY_CACHEDIR}
export APPTAINER_TMPDIR=${SINGULARITY_TMPDIR}
# node memory guard contract: openreward-node-memory-guard.py validate_exact_contract accepts exactly this 5-tuple
# (1920 GiB PBS chunk, fail closed at 85 %, MemAvailable fallback 256 GiB, 2 s poll, 60 s telemetry)
export OPENREWARD_NODE_MEMORY_LIMIT_BYTES=2061584302080
export OPENREWARD_NODE_MEMORY_TRIGGER_PERCENT=85
export OPENREWARD_NODE_MEMORY_FALLBACK_AVAILABLE_BYTES=274877906944
export OPENREWARD_NODE_MEMORY_POLL_SECONDS=2
export OPENREWARD_NODE_MEMORY_TELEMETRY_SECONDS=60
